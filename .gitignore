.DS_Store
node_modules/
# .claude 는 개인 설정(settings.local.json)이 들어가므로 통째로 무시하되,
# 팀이 공유하는 에이전트 정의만 추적한다
.claude/*
!.claude/agents/
_build/.behave/
_react/.visual/
_react/dist/
_react/demo/dist/
_build/contrast.json
_build/.contrast-probe.html
_react/src/chart/ds-chart.js
# 전달 묶음의 바이너리(.tgz · zip)는 _react 에서 npm pack 으로 다시 만든다
_handoff/**/*.tgz
_handoff/*.zip
