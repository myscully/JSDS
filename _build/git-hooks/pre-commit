#!/bin/sh
# 원본(_build/style.src.css)만 고치고 빌드를 안 돌린 채 커밋하는 것을 막는다.
#   build.js 는 style.src.css 를 lib.js 의 siteCss(폰트 URL 한 곳 + 예제 고정 상태)로 바꿔 assets/style.css 로 쓰므로,
#   스테이징된 원본에 같은 변환을 적용해 비교하면 빌드 누락을 정확히 잡아낼 수 있다.
# 연결: git config core.hooksPath _build/git-hooks   (클론마다 한 번)
# 우회: git commit --no-verify
exec node "$(dirname "$0")/check-build.js"
